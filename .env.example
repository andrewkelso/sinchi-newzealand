# Sinchi NZ Website - Environment Variables
# Add these in Vercel Dashboard -> Project Settings -> Environment Variables

# (Optional) n8n webhook URL to receive Free Google Visibility Check submissions
N8N_AUDIT_WEBHOOK_URL=https://your-n8n-instance.com/webhook/sinchi-audit-submission

# (Optional) n8n webhook URL to receive 3 Quick Fixes lead captures
N8N_TIPS_WEBHOOK_URL=https://your-n8n-instance.com/webhook/sinchi-tips-submission
