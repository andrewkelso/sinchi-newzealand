---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import FeatureAuditModal from '../components/FeatureAuditModal.astro';

const websiteFeatures = [
  {
    icon: "⚡",
    title: "Mobile Speed & Core Web Vitals",
    badge: "Speed Lever 1 of 6 · Google Mobile Standard",
    subtitle: "Sub-2-second mobile load speeds and 95+ Google Lighthouse scores.",
    desc: "We compress images to modern WebP/AVIF formats, optimize render-blocking CSS/JS, and ensure your site loads in under 2 seconds on mobile data.",
    deepdive: "Google strictly enforces mobile-first indexing and penalizes sites that flunk Core Web Vitals. When a Kiwi customer taps your Google Maps link on a 4G connection, every second of loading lag doubles bounce rates. We optimize assets, streamline scripts, and ensure your site renders near-instantly.",
    checklist: [
      "Modern WebP/AVIF image compression with zero visual degradation",
      "Elimination of render-blocking JavaScript and bulky CSS",
      "Sub-2-second Largest Contentful Paint (LCP) performance target"
    ]
  },
  {
    icon: "📱",
    title: "One-Tap Click-to-Call Buttons",
    badge: "Conversion Lever 2 of 6 · Immediate Lead Capture",
    subtitle: "Zero-friction telephone triggers and streamlined mobile enquiry forms.",
    desc: "We install persistent, high-converting mobile phone call buttons and clean 3-field enquiry forms so customers can reach you with zero friction.",
    deepdive: "Over 70% of local service queries happen on smartphones where customers want immediate assistance. If your phone number isn't one-tap clickable or is hidden in a desktop header, visitors bounce to your competitor. We install sticky mobile call triggers and friction-free enquiry popups.",
    checklist: [
      "Sticky floating mobile call bar with native one-tap dialing",
      "Streamlined 3-field contact forms with instant mobile validation",
      "Google Analytics 4 event tracking for phone clicks and form submissions"
    ]
  },
  {
    icon: "🏙️",
    title: "Service & Suburb Landing Pages",
    badge: "Expansion Lever 3 of 6 · Regional Radius Expansion",
    subtitle: "Capture customer searches across every neighboring town you service.",
    desc: "We build dedicated pages for each core trade and local suburb you serve (e.g. 'Heat Pump Installation Papakura') so Google ranks you in neighboring towns.",
    deepdive: "A single homepage can rarely rank for multiple surrounding suburbs. By structuring dedicated landing pages for each service and high-value suburb in your territory, you provide Google with the localized content it requires to serve your business to customers across the region.",
    checklist: [
      "Dedicated high-intent suburb URL structure and breadcrumbs",
      "Custom localized trade copy referencing local landmarks and needs",
      "Direct cross-linking between your Google Profile service areas and site"
    ]
  },
  {
    icon: "🤖",
    title: "LocalBusiness JSON-LD Schema",
    badge: "Entity Lever 4 of 6 · Machine-Readable Authority",
    subtitle: "Structured semantic data for Google, Bing, and AI search engines.",
    desc: "We implement comprehensive machine-readable schema for Google, Apple Maps, and AI search engines, confirming your legal entity, services, and areas served.",
    deepdive: "AI search engines (Perplexity, ChatGPT) and Google's local knowledge graph rely on structured JSON-LD code to verify your business identity without guessing. We embed rich schemas defining your exact trade categories, geo-coordinates, operating hours, and customer review summaries.",
    checklist: [
      "Full LocalBusiness JSON-LD schema integration in site headers",
      "Precise geo-coordinates, postal areas, and opening hour verification",
      "BreadcrumbList and FAQ rich snippet markup for enhanced SERP presence"
    ]
  },
  {
    icon: "🔄",
    title: "Profile & Website Alignment",
    badge: "Trust Lever 5 of 6 · Algorithmic Consistency",
    subtitle: "Matching headings, categories, and NAP character-for-character.",
    desc: "We align your website's primary heading, metadata, contact info, and business categories with your Google Business Profile to maximize ranking trust.",
    deepdive: "Google checks whether your website substantiates your Google Business Profile. If your profile claims you specialize in 'Drain Unblocking' but your website never mentions it in an H1 heading or service menu, your authority drops. We align all titles, contact records, and trade terms seamlessly.",
    checklist: [
      "H1 and meta title synchronization with primary Google categories",
      "Exact character-for-character Name, Address, Phone (NAP) matching",
      "Direct embedded Google Maps verification and business profile link"
    ]
  },
  {
    icon: "🛡️",
    title: "Local Trust Signals & Proof",
    badge: "Authority Lever 6 of 6 · Customer Conversion",
    subtitle: "Kiwi trade accreditation, real photo galleries, and verified reviews.",
    desc: "We embed your real Google reviews, trade licences, Master Builders / Master Plumbers credentials, and photos of real work to convert cautious visitors.",
    deepdive: "Kiwis want proof before letting a tradesperson or professional into their home. We embed live Google review feeds, authentic photos of local work sites, and prominent industry badges (Master Builders, Registered Electricians, Site Safe) to turn casual browsers into booked appointments.",
    checklist: [
      "Live verified Google review badge integration with star ratings",
      "Prominent NZ trade association accreditations and licence proofs",
      "Authentic on-site photo galleries showcasing local Kiwi projects"
    ]
  }
];


const websiteFaqs = [
  {
    q: "Why does my website speed affect my Google Maps ranking?",
    a: "Google's local search algorithm evaluates your website to verify entity trust, mobile responsiveness, and Core Web Vitals. A slow, unresponsive website weakens your profile's authority and causes mobile visitors to bounce, signaling poor user experience to Google."
  },
  {
    q: "Do I have to rebuild my entire website from scratch?",
    a: "Usually, no. In most cases, we can optimize your existing WordPress, Squarespace, Wix, or custom site by eliminating heavy scripts, setting up click-to-call buttons, adding LocalBusiness schema, and creating dedicated suburb service pages."
  },
  {
    q: "What is LocalBusiness Schema markup and why does it matter?",
    a: "LocalBusiness Schema is structured JSON-LD code embedded in your site that explicitly tells Google, Bing, and AI crawlers your exact business name, phone number, operating hours, service areas, and geo-coordinates without relying on visual interpretation."
  },
  {
    q: "How fast should my website load on a mobile phone?",
    a: "Under Google's Core Web Vitals standard, the Largest Contentful Paint (LCP) should occur within 2.5 seconds, and the site should be instantly interactive. We optimize images, fonts, and scripts to hit 95+ mobile Lighthouse performance."
  },
  {
    q: "How long do typical website updates take to complete?",
    a: "Standard speed, schema, and mobile call-to-action updates are typically completed and deployed within 3 to 7 working days with zero downtime to your live website."
  }
];

const pageBreadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Website Updates', url: '/website-updates' }
];

const serviceJsonLd = [
  {
    "@type": "Service",
    "@id": "https://sinchi.co.nz/website-updates#service",
    "name": "Website Speed & Conversion Updates for NZ Businesses",
    "serviceType": "Website Performance & Local Conversion Optimisation",
    "description": "Website updates that turn Google visitors into phone calls. Fast mobile speeds, click-to-call buttons, LocalBusiness schema, and service area pages for NZ businesses.",
    "provider": {
      "@id": "https://sinchi.co.nz/#organization"
    },
    "areaServed": {
      "@type": "Country",
      "name": "New Zealand"
    },
    "termsOfService": "https://sinchi.co.nz/terms",
    "offers": {
      "@type": "Offer",
      "price": "650",
      "priceCurrency": "NZD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "650",
        "priceCurrency": "NZD"
      }
    }
  },
  {
    "@type": "FAQPage",
    "@id": "https://sinchi.co.nz/website-updates#faq",
    "mainEntity": websiteFaqs.map((faq) => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.a
      }
    }))
  }
];
---

<Layout
  title="Website Updates for NZ Small Businesses | Sinchi"
  description="Website updates that turn Google visitors into phone calls. Fast mobile speeds, click-to-call buttons, LocalBusiness schema, and service area pages for NZ businesses."
  breadcrumbs={pageBreadcrumbs}
  jsonLd={serviceJsonLd}
  publishDate="2026-09-29"
  modifiedDate="2026-09-29"
>
  <!-- Service Hero -->
  <section class="service-hero">
    <div class="container container-narrow">
      <div class="badge-pill">
        <span class="badge-dot"></span>
        <span>Website Conversion & Speed · Updated September 2026</span>
      </div>
      <h1 class="service-title">
        Website updates that turn Google visitors into calls
      </h1>
      
      <!-- AEO Answer-First Lead Paragraph (40-60 words) -->
      <div class="answer-first-lead card-surface">
        <p>
          Website updates for local businesses focus on fixing mobile page speed, adding one-tap click-to-call buttons, embedding LocalBusiness structured schema, and creating suburb-targeted service pages. These updates ensure Google validates your local ranking authority and visitors immediately convert into direct phone enquiries.
        </p>
      </div>

      <div class="hero-actions">
        <a href="/free-google-check" class="btn btn-primary">
          Get my free check
        </a>
        <a href="#whats-included" class="service-secondary-btn">
          See what we update ↓
        </a>
      </div>
    </div>
  </section>

  <!-- Inclusions Section -->
  <section class="section section-alt" id="whats-included">
    <div class="container">
      <div class="section-header">
        <div class="badge-pill">
          <span class="badge-dot"></span>
          <span>Technical & Conversion Inclusions</span>
        </div>
        <h2>What we fix on your website</h2>
        <p class="section-intro">
          Targeted technical, conversion, and local SEO enhancements that make a measurable difference.
        </p>
      </div>

      <div class="features-grid">
        {websiteFeatures.map((feat) => (
          <div
            class="feature-item card-surface"
            data-feature-card="true"
            data-feature-data={JSON.stringify(feat)}
            role="button"
            tabindex="0"
            aria-label={`Open details and audit for ${feat.title}`}
          >
            <div class="feature-card-header">
              <div class="feature-icon">{feat.icon}</div>
              <span class="feature-badge-mini">Tap to inspect & audit ↗</span>
            </div>
            <h3>{feat.title}</h3>
            <p>{feat.desc}</p>
            <div class="feature-cue-row">
              <span class="feature-cue-btn">Get free inspection →</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Before & After Comparison -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div class="badge-pill">
          <span class="badge-dot"></span>
          <span>Conversion Benchmark</span>
        </div>
        <h2>The difference between a leaky site and a converting site</h2>
        <p class="section-intro">
          Why small technical and layout changes dramatically boost phone enquiries.
        </p>
      </div>

      <div class="comparison-grid">
        <!-- Before Card -->
        <div class="comparison-card before-card card-surface">
          <div class="comparison-header">
            <span class="comparison-badge before-badge">Before Updates</span>
            <h3 class="comparison-title">A Leaky Website</h3>
          </div>
          <ul class="comparison-list">
            <li>✕ Takes 5+ seconds to load on mobile phones</li>
            <li>✕ Phone number is buried in tiny footer text</li>
            <li>✕ Generic homepage trying to cover everything</li>
            <li>✕ Zero schema data for Google's local algorithm</li>
            <li>✕ 75% of visitors bounce without calling</li>
          </ul>
        </div>

        <!-- After Card -->
        <div class="comparison-card after-card card-surface">
          <div class="comparison-header">
            <span class="comparison-badge after-badge">After Sinchi Updates</span>
            <h3 class="comparison-title">A High-Converting Local Site</h3>
          </div>
          <ul class="comparison-list">
            <li>✓ Loads in under 1.5 seconds on mobile data</li>
            <li>✓ Sticky click-to-call button always visible on screen</li>
            <li>✓ Dedicated suburb pages matching local searches</li>
            <li>✓ Full LocalBusiness JSON-LD structured schema</li>
            <li>✓ High-trust proof converts visitors into phone calls</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Section -->
  <section class="section section-alt" id="pricing">
    <div class="container container-narrow">
      <div class="pricing-card card-surface">
        <div class="badge-pill">
          <span class="badge-dot"></span>
          <span>Transparent Pricing</span>
        </div>
        <h2 class="pricing-title">Website Speed & Conversion Updates</h2>
        <p class="pricing-subtitle">One-off tune-up or bundled with monthly ranking.</p>

        <div class="pricing-amount">
          <span class="currency">NZD</span>
          <span class="price">From $650</span>
          <span class="period">one-off</span>
        </div>

        <p class="pricing-note">
          Includes full Core Web Vitals speed optimization, mobile click-to-call implementation, LocalBusiness schema injection, and conversion tuning.
        </p>

        <ul class="pricing-checks">
          <li>✓ 95+ Mobile Lighthouse performance target</li>
          <li>✓ One-tap phone calling & simplified enquiry forms</li>
          <li>✓ Validated LocalBusiness Schema JSON-LD markup</li>
          <li>✓ Suburb and service alignment with Google profile</li>
          <li>✓ Full before/after speed and conversion benchmark report</li>
        </ul>

        <div class="pricing-cta">
          <a href="/free-google-check" class="btn btn-primary btn-pricing">
            Request my free website & ranking check
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section">
    <div class="container container-narrow">
      <div class="section-header">
        <div class="badge-pill">
          <span class="badge-dot"></span>
          <span>FAQ</span>
        </div>
        <h2>Frequently asked questions</h2>
        <p class="section-intro">Straight answers about website speed and conversion fixes.</p>
      </div>

      <div class="faq-list">
        {websiteFaqs.map((faq) => (
          <div class="faq-card card-surface">
            <h3 class="faq-card-title">{faq.q}</h3>
            <p class="faq-card-desc">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA Band -->
  <CtaBand
    title="Turn your website into your best salesperson"
    subtitle="Let's audit your site's mobile speed, schema, and local Google visibility for free."
    primaryButtonText="Get my free check"
  />

  <!-- Interactive Deep Dive & In-Modal Free Audit Modal -->
  <FeatureAuditModal />
</Layout>

<style>
  /* Service Hero */
  .service-hero {
    padding-top: clamp(3rem, 6vw, 5.5rem);
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
    text-align: center;
  }

  .service-title {
    font-size: clamp(2.35rem, 4.5vw, 3.75rem);
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    line-height: 1.15;
  }

  .answer-first-lead {
    background: rgba(36, 6, 56, 0.75);
    border-left: 4px solid var(--color-primary-light);
    padding: 1.5rem 1.75rem;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    text-align: left;
    margin: 0 auto 2.25rem auto;
    max-width: 740px;
  }

  .answer-first-lead p {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text-main);
    font-weight: 500;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .service-secondary-btn {
    font-weight: 700;
    font-size: 1rem;
    color: #FFFFFF;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .service-secondary-btn:hover {
    color: var(--color-primary-light);
  }

  /* Section Headers */
  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3rem auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .section-intro {
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  /* Features Grid */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 2rem;
  }

  .feature-item {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    position: relative;
    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1),
                border-color 220ms ease,
                box-shadow 220ms ease;
    outline: none;
  }

  .feature-item:hover,
  .feature-item:focus-visible {
    transform: translateY(-5px);
    border-color: var(--color-primary-light);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6), 0 0 28px rgba(157, 56, 224, 0.35);
  }

  .feature-item:focus-visible {
    box-shadow: 0 0 0 3px var(--color-primary-light);
  }

  .feature-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .feature-icon {
    font-size: 2.25rem;
    width: 54px;
    height: 54px;
    border-radius: var(--radius-md);
    background-color: var(--color-lilac-soft);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-badge-mini {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-primary-light);
    background: rgba(157, 56, 224, 0.15);
    border: 1px solid rgba(192, 132, 252, 0.35);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-full);
    transition: background 150ms ease, color 150ms ease;
  }

  .feature-item:hover .feature-badge-mini {
    background: var(--color-primary);
    color: #FFFFFF;
    border-color: #C084FC;
  }

  .feature-item h3 {
    font-size: 1.25rem;
    margin-bottom: 0.6rem;
    color: #FFFFFF;
  }

  .feature-item p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }

  .feature-cue-row {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px dashed rgba(192, 132, 252, 0.2);
  }

  .feature-cue-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-primary-light);
    transition: color 150ms ease, transform 150ms ease;
  }

  .feature-item:hover .feature-cue-btn {
    color: #FFFFFF;
    transform: translateX(4px);
  }

  /* Comparison Grid */
  .comparison-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .comparison-card {
    border-radius: var(--radius-lg);
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
  }

  .before-card {
    background: rgba(45, 10, 18, 0.6);
    border: 1.5px solid rgba(239, 68, 68, 0.3);
  }

  .after-card {
    background: rgba(38, 8, 62, 0.85);
    border: 2px solid var(--color-primary-light);
    box-shadow: 0 0 24px rgba(157, 56, 224, 0.3);
  }

  .comparison-header {
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: 1rem;
  }

  .comparison-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    margin-bottom: 0.5rem;
  }

  .before-badge {
    background-color: rgba(239, 68, 68, 0.2);
    color: #F87171;
    border: 1px solid rgba(239, 68, 68, 0.4);
  }

  .after-badge {
    background-color: rgba(16, 185, 129, 0.2);
    color: #34D399;
    border: 1px solid rgba(16, 185, 129, 0.4);
  }

  .comparison-title {
    font-size: 1.375rem;
    color: #FFFFFF;
  }

  .comparison-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .before-card .comparison-list li {
    color: #FCA5A5;
  }

  .after-card .comparison-list li {
    color: #E9D5FF;
  }

  /* Pricing Card */
  .pricing-card {
    border: 2px solid var(--color-primary-light);
    padding: clamp(2.25rem, 5vw, 3.5rem);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pricing-title {
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    margin-top: 0.85rem;
    margin-bottom: 0.5rem;
    color: #FFFFFF;
  }

  .pricing-subtitle {
    color: var(--color-text-muted);
    font-size: 1.0625rem;
    margin-bottom: 1.75rem;
  }

  .pricing-amount {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .currency {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .price {
    font-size: clamp(2.75rem, 5vw, 3.75rem);
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.03em;
  }

  .period {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .pricing-note {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    max-width: 480px;
    margin: 0 auto 2rem auto;
    line-height: 1.45;
  }

  .pricing-checks {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 480px;
    margin: 0 auto 2.5rem auto;
    text-align: left;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #E9D5FF;
  }

  .btn-pricing {
    width: 100%;
    max-width: 440px;
    padding: 1.1rem 1.75rem;
    font-size: 1.125rem;
  }

  /* FAQ Cards */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .faq-card {
    padding: 1.75rem;
  }

  .faq-card-title {
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
    color: #FFFFFF;
  }

  .faq-card-desc {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  @media (max-width: 860px) {
    .comparison-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
