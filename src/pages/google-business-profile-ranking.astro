---
import Layout from '../layouts/Layout.astro';
import GeoGridVisualizer from '../components/GeoGridVisualizer.astro';
import IndustryTabsModule from '../components/IndustryTabsModule.astro';
import FeatureAuditModal from '../components/FeatureAuditModal.astro';
import CtaBand from '../components/CtaBand.astro';

const gbpFeatures = [
  {
    icon: "🏷️",
    title: "Category & Service Architecture",
    badge: "Lever 1 of 6 · Primary Algorithmic Signal",
    subtitle: "Eliminating category dilution and capturing high-intent Kiwi search phrases.",
    desc: "We audit high-volume search queries and assign the highest-leverage primary category, supported by exact secondary categories and custom service items with local pricing.",
    deepdive: "Google evaluates your primary Google Business category as its heaviest single algorithmic ranking signal. If an electrician in Papakura is categorized simply as 'Contractor', they miss 80% of local searches. We identify what top 3 competitors use and configure your primary and secondary categories to capture high-intent local calls.",
    checklist: [
      "Competitor category audit across top 3 local rankings",
      "Removal of conflicting secondary categories causing dilution",
      "Custom service menu items with realistic NZ market pricing"
    ]
  },
  {
    icon: "⭐",
    title: "Review Velocity System & Keyword Replies",
    badge: "Lever 2 of 6 · Trust & Keyword Relevancy",
    subtitle: "Consistent weekly reviews with natural trade and suburb keyword responses.",
    desc: "We set up a simple review collection workflow for your customers and provide tailored reply templates that weave in your specific trade and suburb names naturally.",
    deepdive: "A burst of 20 reviews followed by months of silence signals stagnation to Google. We build an automated post-job review request system for your customers, plus engineer keyword-rich owner reply templates (e.g. 'Thanks for trusting us for your heat pump installation in Albany') that prove your service radius.",
    checklist: [
      "1-tap review link automation via SMS / email",
      "Tailored owner reply templates with trade & suburb keywords",
      "Flagging & redressal of unfair or policy-violating reviews"
    ]
  },
  {
    icon: "📍",
    title: "NZ Citation & Directory Sync",
    badge: "Lever 3 of 6 · Geographic Entity Certainty",
    subtitle: "Clean character-for-character NAP across Yellow, Finda, UBD, and Localist.",
    desc: "We build and clean up your Name, Address, and Phone (NAP) citations across trusted New Zealand directories so Google has zero entity ambiguity.",
    deepdive: "If Yellow says 'Suite 2', your website says 'Unit 2', and your Google Profile says 'PO Box', Google's confidence in your physical entity drops. We systematically scrub and sync your Name, Address, and Phone across reputable NZ business directories to anchor your local trust.",
    checklist: [
      "Scrubbing inconsistent phone numbers and old addresses",
      "Direct citation creation on tier-1 New Zealand platforms",
      "Apple Maps, Bing Places, and directory synchronization"
    ]
  },
  {
    icon: "🛡️",
    title: "Spam & Duplicate Redressal",
    badge: "Lever 4 of 6 · Competitor Cleanup",
    subtitle: "Clearing out fake competitor pins, virtual offices, and stuffed keywords.",
    desc: "Competitors often stuff keywords into their business names or create fake pin locations. We submit evidence to Google to have illicit competitor pins removed.",
    deepdive: "In competitive areas like Auckland or Christchurch, rogue operators often create fake Google listings with stuffed names like 'Plumber Emergency Auckland 24/7' or register at unstaffed co-working desks. We gather council, registry, and street-view evidence and file formal redressals to remove them.",
    checklist: [
      "5km radius scan for keyword-stuffed business titles",
      "Identification of virtual office and fake residential pins",
      "Official Google redressal filing with photographic proof"
    ]
  },
  {
    icon: "📸",
    title: "Geotagged Photo & Post Updates",
    badge: "Lever 5 of 6 · Active Operating Signals",
    subtitle: "Proving real local work in real New Zealand suburbs every month.",
    desc: "Regular photo uploads and Google updates showing real, local jobs in your area, signaling active operations to Google's ranking crawlers.",
    deepdive: "Google rewards businesses that demonstrate fresh, local activity. By regularly uploading photos of real work taken in your target suburbs, you supply Google with geotemporal proof that your team is actively completing jobs in those areas.",
    checklist: [
      "Monthly photo upload schedule of authentic job sites",
      "Keyword-optimised Google updates highlighting services",
      "Verification of image metadata and local relevance"
    ]
  },
  {
    icon: "📊",
    title: "Monthly 5km Geo-Grid Tracking",
    badge: "Lever 6 of 6 · Precision Measurement",
    subtitle: "Suburb-by-suburb ranking heatmaps and phone call action trends.",
    desc: "A multi-point map grid report delivered to your inbox every month showing exactly where you rank across each suburb you service, alongside phone call analytics.",
    deepdive: "Traditional rank checkers check rankings from one arbitrary point. Our 5km geo-grid tool checks where your business ranks at 25+ geographic points across your service territory, revealing exactly which suburbs you dominate and where competitors are overtaking you.",
    checklist: [
      "Multi-point geo-grid rank map for high-volume keywords",
      "Direct customer call, website visit, and direction trends",
      "Actionable monthly engineering plan to expand your radius"
    ]
  }
];

const gbpFaqs = [
  {
    q: "How long does it take for a Google Business Profile to rank in the top 3?",
    a: "Most New Zealand businesses notice ranking improvements within 3 to 8 weeks of correcting primary categories, filling profile gaps, and implementing a review schedule. High-density metropolitan searches (like Auckland CBD or Christchurch central) usually take 3 to 5 months of consistent optimization."
  },
  {
    q: "Do I have to give you my Google login password?",
    a: "No. You never need to share your password. You simply invite our agency email as a 'Manager' inside your Google Business Profile dashboard. You retain full primary ownership at all times and can revoke access with a single click."
  },
  {
    q: "What is the difference between a storefront and a service-area business?",
    a: "If customers visit your physical premises (like a dental clinic or retail store), your address is displayed on Google Maps. If you travel to your customers (like an electrician, plumber, or mobile driving school), Google lets you hide your street address and set specific service suburbs across New Zealand."
  },
  {
    q: "How do you handle fake reviews or competitor spam?",
    a: "We systematically audit your local search radius for spam listings (fake names stuffed with keywords, duplicate profiles, and non-existent addresses) and submit formal redressal complaints to Google to remove them, clearing space for legitimate local businesses."
  },
  {
    q: "Can I cancel the monthly ranking service at any time?",
    a: "Yes. All Sinchi monthly optimization agreements operate on a flexible month-to-month basis with zero lock-in contracts. You stay because you are receiving calls, not because of fine print."
  }
];

const pageBreadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Google Business Profile Ranking', url: '/google-business-profile-ranking' }
];

const serviceJsonLd = [
  {
    "@type": "Service",
    "@id": "https://sinchi.co.nz/google-business-profile-ranking#service",
    "name": "Google Business Profile Optimisation & Ranking",
    "serviceType": "Local SEO & Google Maps Optimisation",
    "description": "Google Business Profile ranking service for New Zealand businesses. Climb into the local 3-pack on Google Maps and turn nearby searchers into phone calls.",
    "provider": {
      "@id": "https://sinchi.co.nz/#organization"
    },
    "areaServed": {
      "@type": "Country",
      "name": "New Zealand"
    },
    "termsOfService": "https://sinchi.co.nz/terms",
    "offers": {
      "@type": "Offer",
      "price": "495",
      "priceCurrency": "NZD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "495",
        "priceCurrency": "NZD",
        "unitText": "MONTH"
      }
    }
  },
  {
    "@type": "FAQPage",
    "@id": "https://sinchi.co.nz/google-business-profile-ranking#faq",
    "mainEntity": gbpFaqs.map((faq) => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.a
      }
    }))
  }
];
---

<Layout
  title="Google Business Profile Optimisation NZ | Sinchi"
  description="Google Business Profile ranking service for New Zealand businesses. Climb into the local 3-pack on Google Maps and turn nearby searchers into phone calls."
  breadcrumbs={pageBreadcrumbs}
  jsonLd={serviceJsonLd}
  publishDate="2026-09-29"
  modifiedDate="2026-09-29"
>
  <!-- Service Hero -->
  <section class="service-hero">
    <div class="container container-narrow">
      <div class="badge-pill">
        <span class="badge-dot"></span>
        <span>Google Maps Local Search · Updated September 2026</span>
      </div>
      <h1 class="service-title">
        Google Business Profile optimisation for NZ businesses
      </h1>
      
      <!-- AEO Answer-First Lead Paragraph (40-60 words) -->
      <div class="answer-first-lead card-surface">
        <p>
          Google Business Profile optimisation is the process of configuring, verifying, and actively managing your Google listing so your business appears in the coveted local 3-pack on Google Maps. It is designed for New Zealand tradies, clinics, and service providers who want local customers to find and call them within 3 to 8 weeks.
        </p>
      </div>

      <div class="hero-actions">
        <a href="/free-google-check" class="btn btn-primary">
          Get my free check
        </a>
        <a href="#whats-included" class="service-secondary-btn">
          See what's included ↓
        </a>
      </div>
    </div>
  </section>

  <!-- Interactive Geo-Grid Suburb Heatmap Simulation -->
  <section class="section">
    <div class="container">
      <GeoGridVisualizer />
    </div>
  </section>

  <!-- Inclusions Section -->
  <section class="section section-alt" id="whats-included">
    <div class="container">
      <div class="section-header">
        <div class="badge-pill">
          <span class="badge-dot"></span>
          <span>Comprehensive Scope</span>
        </div>
        <h2>What's included in profile optimisation</h2>
        <p class="section-intro">
          Every lever required to climb Google Maps and maintain your position against aggressive local competitors.
        </p>
      </div>

      <div class="features-grid">
        {gbpFeatures.map((feat) => (
          <div
            class="feature-item card-surface"
            data-feature-card="true"
            data-feature-data={JSON.stringify(feat)}
            role="button"
            tabindex="0"
            aria-label={`Open details and audit for ${feat.title}`}
          >
            <div class="feature-card-header">
              <div class="feature-icon">{feat.icon}</div>
              <span class="feature-badge-mini">Tap to inspect & audit ↗</span>
            </div>
            <h3>{feat.title}</h3>
            <p>{feat.desc}</p>
            <div class="feature-cue-row">
              <span class="feature-cue-btn">Get free inspection →</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Interactive Kiwi Industry Strategy Selector -->
  <section class="section">
    <div class="container">
      <IndustryTabsModule />
    </div>
  </section>

  <!-- Monthly Deliverable Breakdown -->
  <section class="section section-alt">
    <div class="container container-narrow">
      <div class="section-header">
        <div class="badge-pill">
          <span class="badge-dot"></span>
          <span>Reporting Standards</span>
        </div>
        <h2>What you receive every month</h2>
        <p class="section-intro">
          No 50-page jargon PDFs. You get clear numbers showing visibility, phone calls, and ranking progression.
        </p>
      </div>

      <div class="report-breakdown-card card-surface">
        <div class="report-row">
          <div class="report-icon">🗺️</div>
          <div class="report-text">
            <h3>Suburb-by-suburb ranking map</h3>
            <p>A visual heatmap showing whether you are #1, #2, or #3 across all key search terms in your target suburbs.</p>
          </div>
        </div>

        <div class="report-row">
          <div class="report-icon">📞</div>
          <div class="report-text">
            <h3>Direct customer actions</h3>
            <p>Verified counts of phone call clicks, website visits, and driving direction requests originating directly from your Google profile.</p>
          </div>
        </div>

        <div class="report-row">
          <div class="report-icon">🔍</div>
          <div class="report-text">
            <h3>Competitor movement tracking</h3>
            <p>Alerts if a new competitor enters your area, changes their primary category, or launches an aggressive review campaign.</p>
          </div>
        </div>

        <div class="report-row">
          <div class="report-icon">🔧</div>
          <div class="report-text">
            <h3>Action plan for the following month</h3>
            <p>Exact next steps we are executing to expand your ranking radius into neighboring suburbs.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Transparent Pricing Section -->
  <section class="section" id="pricing">
    <div class="container container-narrow">
      <div class="pricing-card card-surface">
        <div class="badge-pill">
          <span class="badge-dot"></span>
          <span>Simple, Transparent Pricing</span>
        </div>
        <h2 class="pricing-title">Google Business Profile Ranking</h2>
        <p class="pricing-subtitle">Everything needed to gain and keep your top 3 position.</p>

        <div class="pricing-amount">
          <span class="currency">NZD</span>
          <span class="price">From $495</span>
          <span class="period">/ month</span>
        </div>

        <p class="pricing-note">
          Exact pricing depends on your service territory size and local competition. We provide a firm quote inside your free visibility report.
        </p>

        <ul class="pricing-checks">
          <li>✓ Complete profile setup, optimization & verification support</li>
          <li>✓ NZ directory citation building & NAP cleanup</li>
          <li>✓ Monthly geo-grid tracking across your target suburbs</li>
          <li>✓ Spam listing removal & profile protection</li>
          <li>✓ Zero lock-in contracts (month-to-month flexibility)</li>
        </ul>

        <div class="pricing-cta">
          <a href="/free-google-check" class="btn btn-primary btn-pricing">
            Get my free visibility check & quote
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section section-alt">
    <div class="container container-narrow">
      <div class="section-header">
        <div class="badge-pill">
          <span class="badge-dot"></span>
          <span>FAQ</span>
        </div>
        <h2>Frequently asked questions</h2>
        <p class="section-intro">Got questions about Google Business Profile ranking? Here are the facts.</p>
      </div>

      <div class="faq-list">
        {gbpFaqs.map((faq) => (
          <div class="faq-card card-surface">
            <h3 class="faq-card-title">{faq.q}</h3>
            <p class="faq-card-desc">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA Band -->
  <CtaBand
    title="Ready to climb into the Google Maps top 3?"
    subtitle="Request your free visibility check today. We'll show you where you rank and who is currently taking your calls."
    primaryButtonText="Get my free check"
  />

  <!-- Interactive Deep Dive & Audit Modal -->
  <FeatureAuditModal />
</Layout>

<style>
  /* Service Hero */
  .service-hero {
    padding-top: clamp(3rem, 6vw, 5.5rem);
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
    text-align: center;
  }

  .service-title {
    font-size: clamp(2.35rem, 4.5vw, 3.75rem);
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    line-height: 1.15;
  }

  .answer-first-lead {
    background: rgba(36, 6, 56, 0.75);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary-light);
    padding: 1.5rem 1.75rem;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    text-align: left;
    margin: 0 auto 2.25rem auto;
    max-width: 740px;
    box-shadow: var(--shadow-md);
  }

  .answer-first-lead p {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text-main);
    font-weight: 500;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .service-secondary-btn {
    font-weight: 700;
    font-size: 1rem;
    color: #FFFFFF;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .service-secondary-btn:hover {
    color: var(--color-primary-light);
  }

  /* Section Headers */
  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3rem auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .section-intro {
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  /* Features Grid */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 2rem;
  }

  .feature-item {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    position: relative;
    border: 1.5px solid var(--color-border);
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
    outline: none;
  }

  .feature-item:hover,
  .feature-item:focus-visible {
    transform: translateY(-5px);
    border-color: var(--color-primary-light);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6), 0 0 28px rgba(157, 56, 224, 0.35);
  }

  .feature-item:focus-visible {
    box-shadow: 0 0 0 3px var(--color-primary-light);
  }

  .feature-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .feature-icon {
    font-size: 2.25rem;
    width: 54px;
    height: 54px;
    border-radius: var(--radius-md);
    background-color: var(--color-lilac-soft);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-badge-mini {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-primary-light);
    background: rgba(157, 56, 224, 0.15);
    border: 1px solid rgba(192, 132, 252, 0.35);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-full);
    transition: background 150ms ease, color 150ms ease;
  }

  .feature-item:hover .feature-badge-mini {
    background: var(--color-primary);
    color: #FFFFFF;
    border-color: #C084FC;
  }

  .feature-item h3 {
    font-size: 1.25rem;
    margin-bottom: 0.6rem;
    color: #FFFFFF;
  }

  .feature-item p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }

  .feature-cue-row {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid rgba(192, 132, 252, 0.15);
  }

  .feature-cue-btn {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-primary-light);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: color 150ms ease, transform 150ms ease;
  }

  .feature-item:hover .feature-cue-btn {
    color: #FFFFFF;
    transform: translateX(4px);
  }

  /* Report Breakdown Card */
  .report-breakdown-card {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .report-row {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .report-icon {
    font-size: 1.75rem;
    background-color: var(--color-lilac-soft);
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .report-text h3 {
    font-size: 1.125rem;
    margin-bottom: 0.35rem;
    color: #FFFFFF;
  }

  .report-text p {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* Pricing Card */
  .pricing-card {
    border: 2px solid var(--color-primary-light);
    padding: clamp(2.25rem, 5vw, 3.5rem);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pricing-title {
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    margin-top: 0.85rem;
    margin-bottom: 0.5rem;
    color: #FFFFFF;
  }

  .pricing-subtitle {
    color: var(--color-text-muted);
    font-size: 1.0625rem;
    margin-bottom: 1.75rem;
  }

  .pricing-amount {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .currency {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .price {
    font-size: clamp(2.75rem, 5vw, 3.75rem);
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.03em;
  }

  .period {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .pricing-note {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    max-width: 480px;
    margin: 0 auto 2rem auto;
    line-height: 1.45;
  }

  .pricing-checks {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 460px;
    margin: 0 auto 2.5rem auto;
    text-align: left;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #E9D5FF;
  }

  .btn-pricing {
    width: 100%;
    max-width: 420px;
    padding: 1.1rem 1.75rem;
    font-size: 1.125rem;
  }

  /* FAQ Cards */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .faq-card {
    padding: 1.75rem;
  }

  .faq-card-title {
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
    color: #FFFFFF;
  }

  .faq-card-desc {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  @media (max-width: 600px) {
    .report-row {
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>
