---
import Layout from '../layouts/Layout.astro';
import MapsHeroVisual from '../components/MapsHeroVisual.astro';
import AuditReportMockup from '../components/AuditReportMockup.astro';
import LocalCallEstimator from '../components/LocalCallEstimator.astro';
import CtaBand from '../components/CtaBand.astro';

const homeFaqs = [
  {
    question: "How long does it take to rank on Google Maps in New Zealand?",
    answer: "Most local NZ businesses see noticeable movement within 3 to 8 weeks after fixing primary categories, addressing profile suspension risks, and correcting website schema. Highly competitive areas (e.g. Auckland plumbers or lawyers) take 3 to 6 months of steady review acquisition and citation signals to secure top 3 positions."
  },
  {
    question: "Do I need a website if I only want Google Maps rankings?",
    answer: "Yes. Google uses your website's speed, LocalBusiness structured data, and service area content to confirm what your business does and where you operate. A fast website that matches your Google Business Profile is one of the strongest ranking signals for local search."
  },
  {
    question: "Can you guarantee a top 3 ranking on Google?",
    answer: "No, and any agency that promises a guaranteed ranking is misleading you. Google explicitly states that no one can guarantee a #1 position. We use proven, compliant optimization methods that give your business the strongest possible mathematical advantage to rank and stay there."
  },
  {
    question: "How much does local SEO cost in New Zealand?",
    answer: "In New Zealand, legitimate local SEO and Google Business Profile optimization typically ranges between $450 and $1,200 NZD per month depending on your market competition and service area size. We provide exact, fixed pricing in your free visibility report with no lock-in contracts."
  }
];
---

<Layout
  title="Google Business Profile & Local SEO for NZ Businesses | Sinchi"
  description="We fix your Google Business Profile and website so local customers call you, not the business down the road. Free Google visibility check for NZ businesses."
>
  <!-- 1. HERO SECTION -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-content">
        <div class="badge-pill">
          <span class="badge-dot"></span>
          <span>Google Maps Specialists · New Zealand</span>
        </div>

        <h1 class="hero-title">
          Get found on Google Maps by customers near you
        </h1>
        <p class="hero-subtitle">
          We fix your Google Business Profile and website so local customers call you, not the business down the road.
        </p>

        <div class="hero-cta-group">
          <a href="/free-google-check" class="btn btn-primary btn-hero">
            Get my free check
          </a>
          <a href="/3-quick-fixes" class="hero-secondary-link">
            Send me the 3 fixes
          </a>
        </div>

        <div class="hero-badges">
          <div class="hero-badge-item">
            <span class="badge-icon">✓</span>
            <span>Takes 60 seconds to request</span>
          </div>
          <div class="hero-badge-item">
            <span class="badge-icon">✓</span>
            <span>Personalised report in 1 working day</span>
          </div>
          <div class="hero-badge-item">
            <span class="badge-icon">✓</span>
            <span>No sales pitch unless you ask</span>
          </div>
        </div>
      </div>

      <div class="hero-visual-wrapper">
        <MapsHeroVisual />
      </div>
    </div>
  </section>

  <!-- 2. PROBLEM SECTION: WHY YOU'RE NOT IN THE TOP 3 -->
  <section class="section section-problem">
    <div class="container container-narrow">
      <div class="problem-card card-surface">
        <div class="badge-pill">
          <span class="badge-dot"></span>
          <span>The Local Visibility Gap</span>
        </div>
        <h2 class="problem-title">Why you're not in the top 3</h2>
        <div class="problem-text">
          <p>
            Most customers searching on their phone never scroll past the three businesses shown in the Google map. If you are fourth or lower, you are practically invisible.
          </p>
          <p>
            Usually, your work is not the problem. It comes down to a handful of straightforward, fixable factors: the wrong primary category, too few recent reviews, or a website that does not back up your profile to Google's ranking algorithm.
          </p>
        </div>
        <div class="problem-takeaway">
          <strong>The good news:</strong> Once these specific signals are corrected, your profile starts climbing ahead of competitors who have left their listings on autopilot.
        </div>
      </div>
    </div>
  </section>

  <!-- 3. INTERACTIVE REVENUE / CALL ESTIMATOR MODULE -->
  <section class="section">
    <div class="container">
      <LocalCallEstimator />
    </div>
  </section>

  <!-- 4. TWO CORE SERVICES -->
  <section class="section section-services" id="services">
    <div class="container">
      <div class="section-header">
        <div class="badge-pill">
          <span class="badge-dot"></span>
          <span>Core Offers</span>
        </div>
        <h2 class="section-title">Two ways we help your business win local calls</h2>
        <p class="section-intro">
          We focus exclusively on two levers that generate direct phone calls for local New Zealand businesses.
        </p>
      </div>

      <div class="services-grid">
        <!-- Service Card 1 -->
        <div class="service-card card-surface">
          <div class="service-icon-box">📍</div>
          <h3 class="service-card-title">Google Business Profile Ranking</h3>
          <p class="service-card-desc">
            Optimise your profile to climb into the local 3-pack for high-intent searches across the suburbs you serve.
          </p>
          <ul class="service-features">
            <li>Primary & secondary category alignment</li>
            <li>Review generation system & keyword reply templates</li>
            <li>NAP citation consistency across NZ directories</li>
            <li>Spam competitor & duplicate listing removal</li>
            <li>Monthly geo-grid ranking reports across your area</li>
          </ul>
          <div class="service-card-footer">
            <a href="/google-business-profile-ranking" class="service-link">
              Explore profile optimisation →
            </a>
          </div>
        </div>

        <!-- Service Card 2 -->
        <div class="service-card card-surface">
          <div class="service-icon-box">⚡</div>
          <h3 class="service-card-title">Website Updates</h3>
          <p class="service-card-desc">
            Fix your website so mobile visitors can tap to call immediately, and Google gets the structured proof it needs.
          </p>
          <ul class="service-features">
            <li>Lightning-fast mobile load speed & Core Web Vitals</li>
            <li>High-converting click-to-call & enquiry forms</li>
            <li>Targeted service & suburb area pages</li>
            <li>LocalBusiness Schema markup for AI & search bots</li>
            <li>Exact content matching with your Google profile</li>
          </ul>
          <div class="service-card-footer">
            <a href="/website-updates" class="service-link">
              Explore website updates →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. HOW IT WORKS (GENUINE 3-STEP PROCESS) -->
  <section class="section section-alt" id="how-it-works">
    <div class="container container-narrow">
      <div class="section-header">
        <div class="badge-pill">
          <span class="badge-dot"></span>
          <span>Disciplined Process</span>
        </div>
        <h2 class="section-title">How it works</h2>
        <p class="section-intro">
          A disciplined, engineer's approach to local search. No guesswork, no fluff.
        </p>
      </div>

      <div class="process-steps">
        <!-- Step 1 -->
        <div class="process-step card-surface">
          <div class="step-num-badge">1</div>
          <div class="step-content">
            <h3 class="step-title">We check where you rank today</h3>
            <p class="step-desc">
              We run a geo-grid audit across your service territory to see exactly who is beating you, which categories you are missing, and why Google isn't showing you in the top 3.
            </p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="process-step card-surface">
          <div class="step-num-badge">2</div>
          <div class="step-content">
            <h3 class="step-title">We fix your profile and website</h3>
            <p class="step-desc">
              We correct your profile structure, implement our steady review system, add LocalBusiness schema, and tune your website so it converts traffic into direct phone enquiries.
            </p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="process-step card-surface">
          <div class="step-num-badge">3</div>
          <div class="step-content">
            <h3 class="step-title">We track your position monthly</h3>
            <p class="step-desc">
              Every month, you receive a clear, plain-English report showing your rank changes across every suburb you cover, call volume trends, and the next optimizations planned.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. PROOF & SAMPLE AUDIT SECTION -->
  <section class="section" id="proof">
    <div class="container">
      <div class="section-header">
        <div class="badge-pill">
          <span class="badge-dot"></span>
          <span>Transparent Data</span>
        </div>
        <h2 class="section-title">What you see in your report</h2>
        <p class="section-intro">
          We believe in complete transparency. You get concrete data about your local competition, not vague SEO promises.
        </p>
      </div>

      <AuditReportMockup />
    </div>
  </section>

  <!-- 7. FREQUENTLY ASKED QUESTIONS -->
  <section class="section section-alt" id="faq">
    <div class="container container-narrow">
      <div class="section-header">
        <div class="badge-pill">
          <span class="badge-dot"></span>
          <span>Honest Answers</span>
        </div>
        <h2 class="section-title">Common questions about Google Maps ranking</h2>
        <p class="section-intro">
          Direct, honest answers to what Kiwi business owners ask us most.
        </p>
      </div>

      <div class="faq-list">
        {homeFaqs.map((faq) => (
          <div class="faq-item card-surface">
            <h3 class="faq-question">{faq.question}</h3>
            <p class="faq-answer">{faq.answer}</p>
          </div>
        ))}
      </div>

      <div class="faq-more-wrapper">
        <a href="/faq" class="btn btn-secondary">
          View all questions & answers →
        </a>
      </div>
    </div>
  </section>

  <!-- 8. FINAL CALL TO ACTION -->
  <CtaBand />
</Layout>

<style>
  /* Hero Section */
  .hero-section {
    padding-top: clamp(3rem, 6vw, 5.5rem);
    padding-bottom: clamp(3.5rem, 7vw, 5.5rem);
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero-title {
    font-size: clamp(2.35rem, 4.5vw, 3.85rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .hero-subtitle {
    font-size: clamp(1.125rem, 2vw, 1.3125rem);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .btn-hero {
    padding: 1.05rem 2.25rem;
    font-size: 1.125rem;
  }

  .hero-secondary-link {
    font-weight: 700;
    font-size: 1.0625rem;
    color: var(--color-plum);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color var(--transition-fast);
  }

  .hero-secondary-link:hover {
    color: var(--color-primary);
  }

  .hero-badges {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .hero-badge-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .badge-icon {
    color: var(--color-primary);
    font-weight: 800;
  }

  .hero-visual-wrapper {
    display: flex;
    justify-content: center;
  }

  /* Section Headers */
  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3rem auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .section-intro {
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  /* Problem Section */
  .problem-card {
    padding: clamp(2rem, 5vw, 3.25rem);
  }

  .problem-title {
    font-size: clamp(1.625rem, 3vw, 2.25rem);
    margin-top: 1rem;
    margin-bottom: 1.25rem;
    color: var(--color-plum);
  }

  .problem-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-main);
  }

  .problem-takeaway {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border-subtle);
    font-size: 1rem;
    color: var(--color-plum);
  }

  /* Services Grid */
  .services-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .service-card {
    padding: clamp(2rem, 4vw, 2.75rem);
    display: flex;
    flex-direction: column;
  }

  .service-icon-box {
    font-size: 2.25rem;
    margin-bottom: 1rem;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    background-color: var(--color-lilac-soft);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .service-card-title {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .service-card-desc {
    color: var(--color-text-muted);
    font-size: 1rem;
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }

  .service-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-bottom: 2rem;
    font-size: 0.9375rem;
  }

  .service-features li {
    position: relative;
    padding-left: 1.25rem;
    color: var(--color-text-main);
  }

  .service-features li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: 800;
    font-size: 1.25rem;
    line-height: 1;
  }

  .service-card-footer {
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .service-link {
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    color: var(--color-primary);
  }

  .service-link:hover {
    text-decoration: underline;
  }

  /* Process Steps */
  .process-steps {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .process-step {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 1.75rem 2rem;
  }

  .step-num-badge {
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-plum) 100%);
    color: var(--color-white);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.35rem;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(109, 16, 163, 0.25);
  }

  .step-content {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .step-title {
    font-size: 1.25rem;
  }

  .step-desc {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  /* FAQ List */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .faq-item {
    padding: 1.75rem;
  }

  .faq-question {
    font-size: 1.1875rem;
    margin-bottom: 0.6rem;
    color: var(--color-plum);
  }

  .faq-answer {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .faq-more-wrapper {
    margin-top: 2.25rem;
    text-align: center;
  }

  /* Responsive Breakpoints */
  @media (max-width: 960px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .services-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .hero-cta-group {
      flex-direction: column;
      align-items: stretch;
    }

    .btn-hero {
      width: 100%;
      text-align: center;
    }

    .process-step {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
