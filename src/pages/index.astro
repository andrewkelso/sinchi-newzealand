---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Sinchi | Google Business Profile & Local SEO for NZ Businesses"
  description="We fix your Google Business Profile and website so local customers call you, not the business down the road. Free visibility check for NZ businesses."
>
  <main id="main-content" class="container section">
    <h1>Get found on Google Maps by customers near you</h1>
    <p style="margin-top: 1rem; font-size: 1.25rem;">
      We fix your Google Business Profile and website so local customers call you, not the business down the road.
    </p>
    <div style="margin-top: 2rem; display: flex; gap: 1rem; flex-wrap: wrap;">
      <a href="/free-google-check" class="btn btn-primary">Get my free check</a>
      <a href="/3-quick-fixes" class="btn btn-secondary">Send me the 3 fixes</a>
    </div>
  </main>
</Layout>
