---
import Layout from '../layouts/Layout.astro';
import AuditRadarSimulation from '../components/AuditRadarSimulation.astro';
---

<Layout
  title="Free Google Visibility Check | Sinchi"
  description="See where your New Zealand business ranks on Google Maps and who is beating you. Get your free personalized visibility check within 1 working day."
  hideNav={true}
>
  <div class="landing-wrapper">
    <div class="container">
      <!-- Top Minimal Nav -->
      <div class="landing-header">
        <a href="/" class="landing-logo-link" aria-label="Sinchi — Home">
          <img
            src="/brand/Sinchi_LOGO.png"
            alt="Sinchi"
            width="140"
            height="56"
            class="landing-logo"
            loading="eager"
          />
        </a>
        <a href="/" class="back-home-link">← Back to main site</a>
      </div>

      <div class="landing-hero-headline">
        <div class="badge-pill">
          <span class="badge-dot"></span>
          <span>100% Free · No Obligation</span>
        </div>
        <h1 class="landing-title">See exactly where you rank on Google, free</h1>
        <p class="landing-sub">
          We will run a local geo-grid scan across your service area and send you a plain-English report within one working day.
        </p>
      </div>

      <!-- 2-Column Split: Form on Left, Live Radar Simulation on Right -->
      <div class="landing-split-grid">
        <!-- Left: High Converting Form Card -->
        <div class="landing-card form-side card-surface">
          <h2 class="form-card-title">Request your personalised ranking audit</h2>
          <p class="form-card-sub">Fill in your business details below. Takes 60 seconds.</p>

          <form id="free-check-form" class="check-form" novalidate>
            <!-- Honeypot field (hidden from humans) -->
            <div class="honeypot-field" aria-hidden="true" style="display: none;">
              <label for="website_hp">Leave this empty</label>
              <input type="text" id="website_hp" name="website_hp" tabindex="-1" autocomplete="off" />
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label for="businessName" class="form-label">
                  Business Name <span class="required">*</span>
                </label>
                <input
                  type="text"
                  id="businessName"
                  name="businessName"
                  class="form-input"
                  placeholder="e.g. Papakura Plumbing & Gas"
                  required
                />
                <span class="field-error" id="error-businessName"></span>
              </div>

              <div class="form-group">
                <label for="websiteUrl" class="form-label">
                  Website URL <span class="required">*</span>
                </label>
                <input
                  type="text"
                  id="websiteUrl"
                  name="websiteUrl"
                  class="form-input"
                  placeholder="e.g. www.papakuraplumbing.co.nz (or FB page)"
                  required
                />
                <span class="field-error" id="error-websiteUrl"></span>
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label for="mainService" class="form-label">
                  Main Service / Trade <span class="required">*</span>
                </label>
                <input
                  type="text"
                  id="mainService"
                  name="mainService"
                  class="form-input"
                  placeholder="e.g. Emergency Plumber, Dentist"
                  required
                />
                <span class="field-error" id="error-mainService"></span>
              </div>

              <div class="form-group">
                <label for="townCity" class="form-label">
                  Town / City & Area <span class="required">*</span>
                </label>
                <input
                  type="text"
                  id="townCity"
                  name="townCity"
                  class="form-input"
                  placeholder="e.g. South Auckland, Tauranga"
                  required
                />
                <span class="field-error" id="error-townCity"></span>
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label for="email" class="form-label">
                  Work Email <span class="required">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  class="form-input"
                  placeholder="name@yourbusiness.co.nz"
                  required
                />
                <span class="field-error" id="error-email"></span>
              </div>

              <div class="form-group">
                <label for="phone" class="form-label">
                  Phone Number <span class="optional">(Optional)</span>
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  class="form-input"
                  placeholder="e.g. 021 555 1234"
                />
              </div>
            </div>

            <!-- Consent Checkbox -->
            <div class="consent-group">
              <label class="consent-label">
                <input type="checkbox" id="consent" name="consent" class="consent-checkbox" />
                <span class="consent-text">
                  I agree to receive my visibility report and occasional local ranking advice from Sinchi (unsubscribe anytime).
                </span>
              </label>
            </div>

            <div class="form-submit-row">
              <button type="submit" id="submit-btn" class="btn btn-primary btn-submit">
                <span class="btn-text">Get my free check</span>
                <span class="btn-loader" style="display: none;">Scanning listing...</span>
              </button>
            </div>

            <div class="form-global-error" id="form-error" style="display: none;"></div>

            <p class="microcopy">
              🔒 We'll send your report within one working day. No sales call unless you ask for one.
            </p>
          </form>

          <!-- Engineer Trust bar -->
          <div class="landing-trust-bar">
            <div class="trust-engineer-note">
              <span class="engineer-avatar-icon">⚙️</span>
              <p>
                <strong>Engineer's Guarantee:</strong> Every audit is personally reviewed by Andrew, a systems engineer with 20+ years' experience on high-stakes systems. No automated spam.
              </p>
            </div>
          </div>
        </div>

        <!-- Right: Radar Simulation Visual Card -->
        <div class="landing-radar-side">
          <AuditRadarSimulation />
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('free-check-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = submitBtn?.querySelector('.btn-text') as HTMLElement;
  const btnLoader = submitBtn?.querySelector('.btn-loader') as HTMLElement;
  const formError = document.getElementById('form-error') as HTMLElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      formError.style.display = 'none';

      document.querySelectorAll('.field-error').forEach((el) => (el.textContent = ''));

      const formData = new FormData(form);
      const data = {
        website_hp: formData.get('website_hp') || '',
        businessName: formData.get('businessName') || '',
        websiteUrl: formData.get('websiteUrl') || '',
        mainService: formData.get('mainService') || '',
        townCity: formData.get('townCity') || '',
        email: formData.get('email') || '',
        phone: formData.get('phone') || '',
        consent: formData.get('consent') === 'on'
      };

      let hasError = false;
      if (!data.businessName) {
        document.getElementById('error-businessName')!.textContent = 'Business name is required.';
        hasError = true;
      }
      if (!data.websiteUrl) {
        document.getElementById('error-websiteUrl')!.textContent = 'Website link is required.';
        hasError = true;
      }
      if (!data.mainService) {
        document.getElementById('error-mainService')!.textContent = 'Main trade or service is required.';
        hasError = true;
      }
      if (!data.townCity) {
        document.getElementById('error-townCity')!.textContent = 'Town or city is required.';
        hasError = true;
      }
      if (!data.email) {
        document.getElementById('error-email')!.textContent = 'Work email is required.';
        hasError = true;
      }

      if (hasError) return;

      submitBtn.disabled = true;
      btnText.style.display = 'none';
      btnLoader.style.display = 'inline';

      try {
        const res = await fetch('/api/submit-check', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        const result = await res.json();

        if (res.ok && result.success) {
          window.location.href = result.redirect || '/thanks';
        } else {
          formError.textContent = result.error || 'Failed to submit. Please try again.';
          formError.style.display = 'block';
          submitBtn.disabled = false;
          btnText.style.display = 'inline';
          btnLoader.style.display = 'none';
        }
      } catch (err) {
        formError.textContent = 'Network error. Please try again.';
        formError.style.display = 'block';
        submitBtn.disabled = false;
        btnText.style.display = 'inline';
        btnLoader.style.display = 'none';
      }
    });
  }
</script>

<style>
  .landing-wrapper {
    min-height: 100vh;
    padding-top: 1.5rem;
    padding-bottom: 4.5rem;
  }

  .landing-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2.5rem;
  }

  .landing-logo {
    height: 44px;
    width: auto;
  }

  .back-home-link {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-plum);
    text-decoration: none;
  }

  .back-home-link:hover {
    text-decoration: underline;
    color: var(--color-primary);
  }

  .landing-hero-headline {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 3rem auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .landing-title {
    font-size: clamp(2.15rem, 4.5vw, 3.25rem);
    line-height: 1.15;
  }

  .landing-sub {
    font-size: 1.1875rem;
    color: var(--color-text-muted);
  }

  .landing-split-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 2.5rem;
    align-items: stretch;
  }

  .landing-card {
    padding: clamp(2rem, 4vw, 3rem);
  }

  .form-card-title {
    font-size: 1.375rem;
    margin-bottom: 0.35rem;
  }

  .form-card-sub {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin-bottom: 1.75rem;
  }

  /* Form Styles */
  .check-form {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.15rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-label {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-plum);
  }

  .required { color: #D32F2F; }
  .optional { font-size: 0.75rem; color: var(--color-text-light); }

  .form-input {
    width: 100%;
    padding: 0.8125rem 1rem;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 0.9375rem;
    background-color: #FFFFFF;
    color: var(--color-plum);
  }

  .form-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(109, 16, 163, 0.15);
  }

  .field-error {
    font-size: 0.75rem;
    font-weight: 600;
    color: #D32F2F;
    min-height: 0.9rem;
  }

  .consent-label {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    cursor: pointer;
  }

  .consent-checkbox {
    margin-top: 3px;
    width: 18px;
    height: 18px;
    accent-color: var(--color-primary);
  }

  .consent-text {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  .btn-submit {
    width: 100%;
    padding: 1.125rem;
    font-size: 1.125rem;
  }

  .microcopy {
    text-align: center;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .form-global-error {
    background-color: #FFEEEE;
    border: 1px solid #FFCCCC;
    color: #C03232;
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    text-align: center;
    font-weight: 600;
  }

  .landing-trust-bar {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .trust-engineer-note {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background-color: var(--color-lilac-subtle);
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-plum);
  }

  .engineer-avatar-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  @media (max-width: 960px) {
    .landing-split-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
