---
// Google Maps 3-Pack Climber Animation Component (Dark Purple Theme)
---

<div class="maps-hero-card" aria-label="Stylised Google Maps local 3-pack search ranking illustration">
  <!-- Search Bar Header -->
  <div class="maps-search-bar">
    <div class="search-icon-wrapper" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </div>
    <div class="search-query">
      <span class="query-text">plumber near me</span>
      <span class="location-badge">Auckland, NZ</span>
    </div>
    <div class="search-mic" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C084FC" stroke-width="2">
        <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
        <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
        <line x1="12" y1="19" x2="12" y2="23"></line>
        <line x1="8" y1="23" x2="16" y2="23"></line>
      </svg>
    </div>
  </div>

  <!-- Google 3-Pack Header -->
  <div class="pack-header">
    <span class="pack-label">Google Maps Local 3-Pack</span>
    <span class="pack-status">Top visibility zone</span>
  </div>

  <!-- Results List -->
  <div class="results-container">
    <!-- Result 1 (Your Business - Climbs Up) -->
    <div class="result-item result-featured" id="hero-business-card">
      <div class="rank-badge" id="hero-rank-badge">
        <span class="rank-number" id="hero-rank-num">#1</span>
      </div>
      <div class="result-details">
        <div class="result-title-row">
          <span class="business-name">Your Local Business</span>
          <span class="badge-optimised">Top 3</span>
        </div>
        <div class="rating-row">
          <span class="rating-score">4.9</span>
          <div class="stars" aria-label="5 out of 5 stars">
            ★★★★★
          </div>
          <span class="review-count">(64 reviews)</span>
        </div>
        <div class="meta-row">
          <span class="category">Plumber</span> · <span class="open-status">Open now</span> · <span class="distance">2.1 km</span>
        </div>
      </div>
      <div class="call-action-chip" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span>Calls incoming</span>
      </div>
    </div>

    <!-- Result 2 (Competitor A) -->
    <div class="result-item result-standard">
      <div class="rank-badge rank-muted">#2</div>
      <div class="result-details">
        <span class="business-name competitor">Citywide Plumbing & Gas</span>
        <div class="rating-row">
          <span class="rating-score">4.7</span>
          <div class="stars">★★★★★</div>
          <span class="review-count">(41)</span>
        </div>
        <div class="meta-row">
          <span class="category">Plumber</span> · <span>Open · Closes 5pm</span>
        </div>
      </div>
    </div>

    <!-- Result 3 (Competitor B) -->
    <div class="result-item result-standard">
      <div class="rank-badge rank-muted">#3</div>
      <div class="result-details">
        <span class="business-name competitor">Apex Drainage & Plumbing</span>
        <div class="rating-row">
          <span class="rating-score">4.5</span>
          <div class="stars">★★★★☆</div>
          <span class="review-count">(28)</span>
        </div>
        <div class="meta-row">
          <span class="category">Plumbing Service</span> · <span>24 hours</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Cutoff indicator -->
  <div class="cutoff-band">
    <div class="cutoff-line"></div>
    <span class="cutoff-label">92% of searchers never click past this line</span>
    <div class="cutoff-line"></div>
  </div>

  <div class="unseen-zone">
    <div class="unseen-item">
      <span class="rank-muted-small">#4</span>
      <span class="competitor-dim">Southside Gas & Plumbing (Zero calls from search)</span>
    </div>
  </div>
</div>

<style>
  .maps-hero-card {
    background: rgba(28, 4, 46, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1.5px solid rgba(168, 85, 247, 0.35);
    border-radius: var(--radius-xl);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 30px rgba(157, 56, 224, 0.25);
    overflow: hidden;
    width: 100%;
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
  }

  .maps-search-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.95rem 1.25rem;
    background: rgba(45, 8, 72, 0.9);
    border-bottom: 1px solid rgba(168, 85, 247, 0.2);
  }

  .search-icon-wrapper {
    color: var(--color-primary-light);
    display: flex;
    align-items: center;
  }

  .search-query {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .query-text {
    font-weight: 700;
    color: #FFFFFF;
    font-size: 0.9375rem;
  }

  .location-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: #E9D5FF;
    background: rgba(157, 56, 224, 0.25);
    border: 1px solid rgba(168, 85, 247, 0.4);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
  }

  .pack-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.65rem 1.25rem;
    background: rgba(20, 2, 34, 0.6);
    border-bottom: 1px solid rgba(168, 85, 247, 0.15);
    font-size: 0.8125rem;
    font-weight: 700;
    color: #BBA5D3;
  }

  .pack-status {
    color: var(--color-primary-light);
    font-weight: 700;
  }

  .results-container {
    display: flex;
    flex-direction: column;
    padding: 0.85rem;
    gap: 0.6rem;
    position: relative;
  }

  .result-item {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    padding: 0.875rem;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.3s ease, border-color 0.3s ease;
  }

  .result-featured {
    background: linear-gradient(135deg, rgba(62, 12, 100, 0.9) 0%, rgba(42, 6, 70, 0.9) 100%);
    border-color: rgba(192, 132, 252, 0.6);
    box-shadow: 0 4px 20px rgba(157, 56, 224, 0.35);
    position: relative;
    animation: climbToTop 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .result-standard {
    background: rgba(35, 5, 56, 0.5);
    border-color: rgba(168, 85, 247, 0.15);
  }

  .rank-badge {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    font-weight: 800;
    font-size: 0.875rem;
    flex-shrink: 0;
    background: linear-gradient(135deg, #10B981 0%, #059669 100%);
    color: var(--color-white);
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.5);
  }

  .rank-muted {
    background: rgba(255, 255, 255, 0.1);
    color: #BBA5D3;
  }

  .result-details {
    flex: 1;
    min-width: 0;
  }

  .result-title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.2rem;
  }

  .business-name {
    font-weight: 800;
    font-size: 0.9375rem;
    color: #FFFFFF;
  }

  .badge-optimised {
    font-size: 0.6875rem;
    font-weight: 700;
    color: #34D399;
    background-color: rgba(16, 185, 129, 0.2);
    border: 1px solid rgba(16, 185, 129, 0.4);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
  }

  .competitor {
    font-weight: 700;
    color: #E2D4F0;
  }

  .rating-row {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8125rem;
    margin-bottom: 0.2rem;
  }

  .rating-score {
    font-weight: 700;
    color: #FFFFFF;
  }

  .stars {
    color: var(--color-star-gold);
    letter-spacing: 1px;
    font-size: 0.875rem;
  }

  .review-count {
    color: #A98EC7;
  }

  .meta-row {
    font-size: 0.8125rem;
    color: #A98EC7;
  }

  .open-status {
    color: #34D399;
    font-weight: 600;
  }

  .call-action-chip {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    align-self: center;
    background: linear-gradient(135deg, #9D38E0 0%, #6D10A3 100%);
    border: 1px solid #C084FC;
    color: var(--color-white);
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 700;
    white-space: nowrap;
    animation: pulseGlow 2.5s infinite;
  }

  .cutoff-band {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 1.25rem;
    background: rgba(220, 38, 38, 0.12);
    border-top: 1px dashed rgba(239, 68, 68, 0.4);
    border-bottom: 1px dashed rgba(239, 68, 68, 0.4);
  }

  .cutoff-line {
    flex: 1;
    height: 1px;
    background-color: rgba(239, 68, 68, 0.4);
  }

  .cutoff-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #F87171;
    text-align: center;
  }

  .unseen-zone {
    padding: 0.75rem 1.25rem;
    background: rgba(10, 1, 16, 0.6);
    opacity: 0.7;
  }

  .unseen-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8125rem;
  }

  .rank-muted-small {
    color: #8B72A4;
    font-weight: 700;
  }

  .competitor-dim {
    color: #8B72A4;
    font-style: italic;
  }

  @keyframes climbToTop {
    0% {
      transform: translateY(40px) scale(0.98);
      opacity: 0.6;
    }
    100% {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
  }

  @keyframes pulseGlow {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(157, 56, 224, 0.5);
    }
    50% {
      box-shadow: 0 0 0 8px rgba(157, 56, 224, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .result-featured {
      animation: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
    .call-action-chip {
      animation: none !important;
    }
  }
</style>
