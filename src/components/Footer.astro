---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <!-- Top Row: 4 Column Grid -->
    <div class="footer-grid">
      <!-- 1. Entity & Brand Column -->
      <div class="footer-col footer-brand-col">
        <a href="/" class="footer-logo-link" aria-label="Sinchi Home">
          <img
            src="/brand/Sinchi_LOGO.png"
            alt="Sinchi"
            width="140"
            height="56"
            class="footer-logo"
            loading="lazy"
            decoding="async"
          />
        </a>

        <div class="status-indicator-pill">
          <span class="status-dot"></span>
          <span>Available for NZ Visibility Audits</span>
        </div>

        <p class="entity-definition">
          Sinchi is a local SEO service that helps New Zealand businesses rank in Google Maps and improve their websites.
        </p>

        <div class="footer-direct-contact">
          <span class="contact-label">Direct Engineer Contact:</span>
          <a href="mailto:hello@sinchi.co.nz" class="footer-contact-link">
            hello@sinchi.co.nz
          </a>
        </div>
      </div>

      <!-- 2. Services Column -->
      <div class="footer-col">
        <h2 class="footer-heading">Services</h2>
        <ul class="footer-links">
          <li>
            <a href="/google-business-profile-ranking" class="footer-nav-link">
              Google Business Profile Ranking
            </a>
          </li>
          <li>
            <a href="/website-updates" class="footer-nav-link">
              Website Updates & Speed
            </a>
          </li>
          <li>
            <a href="/free-google-check" class="footer-nav-link">
              Free Google Visibility Check
            </a>
          </li>
          <li>
            <a href="/3-quick-fixes" class="footer-nav-link">
              3 Quick Fixes Guide
            </a>
          </li>
        </ul>
      </div>

      <!-- 3. Company Column -->
      <div class="footer-col">
        <h2 class="footer-heading">Company & Trust</h2>
        <ul class="footer-links">
          <li>
            <a href="/about" class="footer-nav-link">About Andrew</a>
          </li>
          <li>
            <a href="/faq" class="footer-nav-link">Questions & Answers</a>
          </li>
          <li>
            <a href="/privacy" class="footer-nav-link">Privacy Policy</a>
          </li>
          <li>
            <a href="/terms" class="footer-nav-link">Terms of Service</a>
          </li>
        </ul>
      </div>

      <!-- 4. New Zealand Focus Column -->
      <div class="footer-col footer-nz-col">
        <h2 class="footer-heading">New Zealand Focus</h2>
        <p class="footer-nz-desc">
          Specialised remote consultancy built exclusively for Kiwi tradies, healthcare clinics, driving schools, and local service providers.
        </p>
        
        <div class="nz-badge-card">
          <div class="nz-badge-header">
            <span class="flag-icon">🇳🇿</span>
            <strong>100% NZ Service Model</strong>
          </div>
          <p class="nz-badge-text">
            Auckland · Christchurch · Wellington · Hamilton · Tauranga · Regional NZ
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom Row: Copyright, Disclaimers & Back to Top -->
    <div class="footer-bottom">
      <div class="footer-bottom-main">
        <p class="copyright">
          © {currentYear} Sinchi. All rights reserved. New Zealand English spelling and pricing in NZD.
        </p>
        <p class="legal-disclaimer">
          Compliant with the NZ Privacy Act 2020 and Fair Trading Act 1986. We never guarantee #1 Google rankings because search algorithms remain under the exclusive control of Google.
        </p>
      </div>

      <div class="footer-bottom-actions">
        <a href="#main-content" class="back-to-top-btn" id="footer-back-to-top">
          <span>Back to top</span>
          <span class="arrow-up">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<script>
  const backToTopBtn = document.getElementById('footer-back-to-top');
  if (backToTopBtn) {
    backToTopBtn.addEventListener('click', (e) => {
      e.preventDefault();
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  }
</script>

<style>
  .site-footer {
    background: linear-gradient(180deg, #10021c 0%, #080010 100%) !important;
    background-color: #0d0117 !important;
    color: #E9D5FF !important;
    border-top: 1px solid rgba(192, 132, 252, 0.25) !important;
    margin-top: auto;
    padding-top: clamp(3.5rem, 6vw, 5rem);
    padding-bottom: 2.5rem;
    position: relative;
    box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.6);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: 2.5rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-brand-col {
    gap: 1.15rem;
  }

  .footer-logo-link {
    display: inline-block;
    transition: opacity var(--transition-fast);
  }

  .footer-logo-link:hover {
    opacity: 0.85;
  }

  .footer-logo {
    height: 42px;
    width: auto;
    display: block;
  }

  .status-indicator-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(52, 211, 153, 0.35);
    color: #6EE7B7;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    width: fit-content;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    background-color: #34D399;
    border-radius: 50%;
    box-shadow: 0 0 8px #34D399;
    animation: pulse-dot 2s infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .entity-definition {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: #D6C2EB;
  }

  .footer-direct-contact {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.875rem;
  }

  .contact-label {
    color: #A78BFA;
    font-weight: 600;
  }

  .footer-contact-link {
    color: #FFFFFF;
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--transition-fast);
  }

  .footer-contact-link:hover {
    color: var(--color-primary-light);
  }

  .footer-heading {
    font-size: 1.0625rem;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.01em;
    margin-bottom: 0.25rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0;
    margin: 0;
  }

  .footer-nav-link {
    color: #D1B8E8;
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    transition: color var(--transition-fast), transform var(--transition-fast);
    display: inline-block;
  }

  .footer-nav-link:hover {
    color: #FFFFFF;
    transform: translateX(3px);
  }

  .footer-nz-desc {
    font-size: 0.875rem;
    line-height: 1.55;
    color: #CBB4E5;
  }

  .nz-badge-card {
    background: rgba(36, 6, 56, 0.7);
    border: 1px solid rgba(192, 132, 252, 0.3);
    border-radius: var(--radius-md);
    padding: 0.875rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .nz-badge-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: #FFFFFF;
    font-size: 0.875rem;
  }

  .flag-icon {
    font-size: 1.1rem;
  }

  .nz-badge-text {
    font-size: 0.75rem;
    color: #D1B8E8;
    line-height: 1.4;
  }

  /* Bottom Bar */
  .footer-bottom {
    border-top: 1px solid rgba(192, 132, 252, 0.2);
    padding-top: 2rem;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
  }

  .footer-bottom-main {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 800px;
  }

  .copyright {
    font-size: 0.8125rem;
    color: #CBB4E5;
    font-weight: 600;
  }

  .legal-disclaimer {
    color: #9A7FB8;
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .back-to-top-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(157, 56, 224, 0.18);
    border: 1px solid rgba(192, 132, 252, 0.35);
    color: #FFFFFF;
    font-size: 0.8125rem;
    font-weight: 700;
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: background-color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
    flex-shrink: 0;
  }

  .back-to-top-btn:hover {
    background-color: var(--color-primary);
    border-color: #C084FC;
    transform: translateY(-2px);
  }

  .arrow-up {
    font-size: 0.875rem;
    font-weight: 800;
  }

  @media (max-width: 960px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 1.5rem;
    }
  }

  @media (max-width: 580px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
