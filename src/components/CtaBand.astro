---
interface Props {
  title?: string;
  subtitle?: string;
  primaryButtonText?: string;
  secondaryButtonText?: string;
}

const {
  title = "See where your business ranks on Google Maps today",
  subtitle = "We'll send your personalised report within one working day. No sales call unless you ask for one.",
  primaryButtonText = "Get my free check",
  secondaryButtonText = "Send me the 3 quick fixes"
} = Astro.props;
---

<section class="cta-band">
  <div class="container container-narrow cta-band-inner">
    <h2 class="cta-title">{title}</h2>
    <p class="cta-subtitle">{subtitle}</p>
    <div class="cta-actions">
      <a href="/free-google-check" class="btn btn-primary cta-btn-primary">
        {primaryButtonText}
      </a>
      <a href="/3-quick-fixes" class="cta-secondary-link">
        {secondaryButtonText}
      </a>
    </div>
    <div class="cta-trust-items">
      <span>✓ 100% Free Visibility Audit</span>
      <span>✓ No Obligation or Pushy Sales</span>
      <span>✓ Real NZ Competitor Data</span>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: linear-gradient(135deg, #2A0840 0%, #190328 100%);
    color: var(--color-white);
    padding: clamp(3.5rem, 7vw, 5rem) 1.5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .cta-band-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .cta-title {
    color: var(--color-white);
    font-size: clamp(1.875rem, 4vw, 2.75rem);
    max-width: 24ch;
  }

  .cta-subtitle {
    color: #D6C2EB;
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
    max-width: 54ch;
    line-height: 1.5;
  }

  .cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .cta-btn-primary {
    background-color: var(--color-primary);
    color: var(--color-white);
    border: 2px solid #8E2BC9;
    padding: 1rem 2rem;
    font-size: 1.125rem;
  }

  .cta-btn-primary:hover {
    background-color: #590B87;
    border-color: #A348DA;
  }

  .cta-secondary-link {
    color: #FFFFFF;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color var(--transition-fast);
  }

  .cta-secondary-link:hover {
    color: var(--color-lilac-soft);
  }

  .cta-trust-items {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
    font-size: 0.875rem;
    color: #BBA0D9;
    font-weight: 600;
    margin-top: 0.75rem;
  }

  @media (max-width: 600px) {
    .cta-actions {
      flex-direction: column;
      width: 100%;
    }

    .cta-btn-primary {
      width: 100%;
    }

    .cta-trust-items {
      flex-direction: column;
      gap: 0.5rem;
      align-items: center;
    }
  }
</style>
