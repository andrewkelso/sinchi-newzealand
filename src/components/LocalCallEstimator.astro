---
// Interactive Local Call & Revenue Impact Estimator (Dark Purple Theme)
---

<div class="calculator-card card-surface" id="call-calculator">
  <div class="calculator-header">
    <div class="badge-pill">
      <span class="badge-dot"></span>
      <span>Interactive NZ Revenue Estimator</span>
    </div>
    <h3 class="calculator-title">Estimate your lost calls from being below the Top 3</h3>
    <p class="calculator-sub">
      See how many direct phone calls you could gain each month by moving from invisible (#4+) into the Google Maps local 3-pack.
    </p>
  </div>

  <div class="calculator-body">
    <!-- Controls Column -->
    <div class="calc-controls">
      <!-- Industry Selector -->
      <div class="calc-group">
        <label for="industry-select" class="calc-label">Your Trade / Industry</label>
        <select id="industry-select" class="calc-select">
          <option value="plumber" data-value="450" data-searches="900" selected>Plumber / Gasfitter (Avg job: $450)</option>
          <option value="electrician" data-value="380" data-searches="850">Electrician (Avg job: $380)</option>
          <option value="drainage" data-value="1200" data-searches="500">Drainlaying & Earthworks (Avg job: $1,200)</option>
          <option value="clinic" data-value="280" data-searches="1100">Clinic / Dentist / Physio (Avg value: $280)</option>
          <option value="driving" data-value="420" data-searches="750">Driving School (Avg package: $420)</option>
          <option value="lawyer" data-value="1800" data-searches="450">Lawyer / Conveyancing (Avg retainer: $1,800)</option>
        </select>
      </div>

      <!-- Search Volume Slider -->
      <div class="calc-group">
        <div class="slider-header">
          <label for="search-slider" class="calc-label">Monthly Searches in Your Suburb</label>
          <span class="slider-display" id="search-val-display">900 searches/mo</span>
        </div>
        <input
          type="range"
          id="search-slider"
          class="calc-slider"
          min="200"
          max="3000"
          step="50"
          value="900"
        />
        <div class="slider-ticks">
          <span>200 (Low)</span>
          <span>1,500 (Medium)</span>
          <span>3,000+ (High Metro)</span>
        </div>
      </div>
    </div>

    <!-- Results Display -->
    <div class="calc-results-card">
      <div class="comparison-bar-block">
        <div class="bar-row">
          <div class="bar-meta">
            <span class="bar-name">Rank #1 to #3 (Local Pack)</span>
            <span class="bar-stat" id="top-calls-stat">~198 calls / mo</span>
          </div>
          <div class="bar-track">
            <div class="bar-fill top-fill" id="top-bar-fill" style="width: 85%;"></div>
          </div>
        </div>

        <div class="bar-row">
          <div class="bar-meta">
            <span class="bar-name dim">Rank #4+ (Hidden Below Fold)</span>
            <span class="bar-stat dim" id="hidden-calls-stat">~18 calls / mo</span>
          </div>
          <div class="bar-track">
            <div class="bar-fill hidden-fill" id="hidden-bar-fill" style="width: 12%;"></div>
          </div>
        </div>
      </div>

      <div class="results-impact-banner">
        <div class="impact-item">
          <span class="impact-label">Estimated Monthly Call Gain</span>
          <span class="impact-val highlight" id="gained-calls">+180 Calls</span>
        </div>
        <div class="impact-divider"></div>
        <div class="impact-item">
          <span class="impact-label">Potential Monthly Revenue Gain</span>
          <span class="impact-val revenue" id="gained-revenue">+$24,300 / mo</span>
        </div>
      </div>

      <div class="calc-cta-row">
        <a href="/free-google-check" class="btn btn-primary btn-calc">
          Get my exact suburb search audit →
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  const industrySelect = document.getElementById('industry-select') as HTMLSelectElement;
  const searchSlider = document.getElementById('search-slider') as HTMLInputElement;
  const searchDisplay = document.getElementById('search-val-display') as HTMLElement;
  const topCallsStat = document.getElementById('top-calls-stat') as HTMLElement;
  const hiddenCallsStat = document.getElementById('hidden-calls-stat') as HTMLElement;
  const gainedCalls = document.getElementById('gained-calls') as HTMLElement;
  const gainedRevenue = document.getElementById('gained-revenue') as HTMLElement;
  const topBarFill = document.getElementById('top-bar-fill') as HTMLElement;
  const hiddenBarFill = document.getElementById('hidden-bar-fill') as HTMLElement;

  function updateCalculator() {
    if (!industrySelect || !searchSlider) return;

    const searches = parseInt(searchSlider.value, 10);
    const selectedOption = industrySelect.options[industrySelect.selectedIndex];
    const avgValue = parseInt(selectedOption.getAttribute('data-value') || '400', 10);

    searchDisplay.textContent = `${searches.toLocaleString()} searches/mo`;

    const topCalls = Math.round(searches * 0.22);
    const hiddenCalls = Math.round(searches * 0.02);
    const diffCalls = Math.max(0, topCalls - hiddenCalls);

    const convertedJobs = Math.round(diffCalls * 0.30);
    const potentialRevenue = convertedJobs * avgValue;

    topCallsStat.textContent = `~${topCalls} calls / mo`;
    hiddenCallsStat.textContent = `~${hiddenCalls} calls / mo`;
    gainedCalls.textContent = `+${diffCalls} Calls / mo`;
    gainedRevenue.textContent = `+$${potentialRevenue.toLocaleString()} NZD`;

    const topPercent = Math.min(95, Math.max(20, (topCalls / (topCalls + 50)) * 100));
    const hiddenPercent = Math.min(25, Math.max(6, (hiddenCalls / (topCalls + 50)) * 100));

    topBarFill.style.width = `${topPercent}%`;
    hiddenBarFill.style.width = `${hiddenPercent}%`;
  }

  if (industrySelect && searchSlider) {
    industrySelect.addEventListener('change', () => {
      const selectedOption = industrySelect.options[industrySelect.selectedIndex];
      const defaultSearches = selectedOption.getAttribute('data-searches');
      if (defaultSearches) {
        searchSlider.value = defaultSearches;
      }
      updateCalculator();
    });

    searchSlider.addEventListener('input', updateCalculator);
    updateCalculator();
  }
</script>

<style>
  .calculator-card {
    padding: clamp(2rem, 5vw, 3.5rem);
    width: 100%;
    margin-top: 1rem;
    position: relative;
    overflow: hidden;
  }

  .calculator-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-primary-light));
  }

  .calculator-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 2.5rem auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .calculator-title {
    font-size: clamp(1.65rem, 3vw, 2.25rem);
    color: #FFFFFF;
  }

  .calculator-sub {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
  }

  .calculator-body {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 2.5rem;
    align-items: center;
  }

  .calc-controls {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .calc-group {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .calc-label {
    font-size: 0.9375rem;
    font-weight: 700;
    color: #FFFFFF;
  }

  .calc-select {
    width: 100%;
    padding: 0.9rem 1rem;
    border: 1.5px solid rgba(168, 85, 247, 0.3);
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #FFFFFF;
    background-color: rgba(16, 2, 26, 0.85);
    cursor: pointer;
  }

  .calc-select:focus {
    outline: none;
    border-color: var(--color-primary-light);
  }

  .slider-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .slider-display {
    font-size: 0.875rem;
    font-weight: 800;
    color: #E9D5FF;
    background-color: rgba(157, 56, 224, 0.25);
    border: 1px solid rgba(168, 85, 247, 0.4);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-sm);
  }

  .calc-slider {
    width: 100%;
    height: 8px;
    border-radius: 4px;
    background: rgba(157, 56, 224, 0.25);
    outline: none;
    accent-color: var(--color-primary-light);
    cursor: pointer;
  }

  .slider-ticks {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  /* Results Card */
  .calc-results-card {
    background: linear-gradient(135deg, #240537 0%, #150222 100%);
    border: 1.5px solid rgba(142, 43, 201, 0.4);
    color: var(--color-white);
    border-radius: var(--radius-lg);
    padding: 2rem;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .comparison-bar-block {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    padding-bottom: 1.5rem;
  }

  .bar-row {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .bar-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .bar-name {
    color: #FFFFFF;
  }

  .bar-name.dim {
    color: #A98EC7;
  }

  .bar-stat {
    color: #FFFFFF;
  }

  .bar-stat.dim {
    color: #A98EC7;
  }

  .bar-track {
    width: 100%;
    height: 10px;
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .bar-fill {
    height: 100%;
    border-radius: var(--radius-full);
    transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .top-fill {
    background: linear-gradient(90deg, #9D38E0, #C084FC);
  }

  .hidden-fill {
    background-color: #553B6D;
  }

  .results-impact-banner {
    display: flex;
    align-items: center;
    justify-content: space-around;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    padding: 1rem;
  }

  .impact-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    text-align: center;
  }

  .impact-label {
    font-size: 0.75rem;
    color: #D6C2EB;
    font-weight: 600;
  }

  .impact-val {
    font-size: 1.375rem;
    font-weight: 800;
  }

  .impact-val.highlight {
    color: #FFFFFF;
  }

  .impact-val.revenue {
    color: #34D399;
  }

  .impact-divider {
    width: 1px;
    height: 36px;
    background-color: rgba(255, 255, 255, 0.15);
  }

  .btn-calc {
    width: 100%;
    padding: 0.95rem;
    font-size: 1rem;
  }

  @media (max-width: 880px) {
    .calculator-body {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .results-impact-banner {
      flex-direction: column;
      gap: 1rem;
    }

    .impact-divider {
      width: 100%;
      height: 1px;
    }
  }
</style>
